[Unit]
Description=Vaultwarden (Bitwarden) docker containers and reverse proxy
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/user/bitwarden-server
ExecStart=/usr/bin/docker compose up --detach
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
